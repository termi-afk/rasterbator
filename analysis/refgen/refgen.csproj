<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>refgen</AssemblyName>
    <RootNamespace>RefGen</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Rasterbator">
      <HintPath>..\..\Rasterbator.exe</HintPath>
    </Reference>
    <Reference Include="itextsharp">
      <HintPath>..\oracle\orig\rs10\Rasterbator Standalone\itextsharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
